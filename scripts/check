#!/bin/sh
# Run the lander's checks, in the lander's order, and print one line per step.
#
#   scripts/check                   fmt, scripts, deny, ultimate, clippy, linux, test
#   scripts/check --only <test>     fmt, clippy, linux, and only the tests matching <test>
#
# A failing step prints only its relevant output (for the tests, the failing tests and their panics) and the
# script exits with that step's exit code, so nothing needs to be piped through grep or tail.
#
# The tests run with TMPDIR set to a short directory under /tmp: a test that binds a Unix socket under a long
# TMPDIR exceeds the socket path limit (104 bytes on macOS).
#
# The linux step runs clippy for x86_64-unknown-linux-gnu, so code behind a cfg for one OS cannot leave the other's
# build with a lint (dead code, unused imports). Clippy only type-checks, so no Linux linker is needed; the target's
# standard library is, and rustup installs it from rust-toolchain.toml. Without it the step is skipped with a note; on
# that target the clippy step already covered it. The lander runs it and fails without the target.
#
# The scripts step (scripts/lint) is skipped, with a note, on a machine without shellcheck or actionlint; CI
# installs both.
#
# The ultimate step (ultimate/check, the Ultimate extension's tests and type checks) runs only when ultimate/ differs
# from main, against the Ultimate ultimate/check --which names ($ULTIMATE, else "ultimateCheck" in
# .ultimate/settings.json). Without one that has node_modules, as in CI, it is skipped with a note. The lander runs it
# under the same condition and fails without one.

set -eu
# shellcheck disable=SC3040 # pipefail only where the shell has it
if (set -o pipefail) 2>/dev/null; then set -o pipefail; fi

usage() {
	echo "usage: scripts/check [--only <test-name>]" >&2
	exit 2
}

only=
case $# in
0) ;;
2) [ "$1" = --only ] || usage; only=$2 ;;
*) usage ;;
esac

cd "$(dirname "$0")/.."
scratch=$(mktemp -d /tmp/fkl.XXXXXX)
trap 'rm -rf "$scratch"' EXIT
out=$scratch/out

# Cargo's progress lines, which say nothing about a failure.
progress='^ *(Compiling|Checking|Finished|Running|Doc-tests|Blocking|Locking|Updating|Downloading|Downloaded) '

# The relevant part of a failed step's output in $out.
explain() {
	if [ "$1" = test ] && grep -q '^failures:$' "$out"; then
		# Each failing test's captured output and panic, the list of failures and the result line, then
		# cargo's note on which binary failed. Other lines are left out: tests' child processes write to
		# stderr uncaptured, passing tests included.
		awk '/^---- .* ----$/ || /^failures:$/ { show = 1 }
			show { print }
			/^test result: / { show = 0 }
			/^error: test failed/ { print }' "$out"
	else
		grep -Ev "$progress" "$out" || true
	fi
}

# Run one step: its name, then its command.
step() {
	name=$1
	shift
	start=$(date +%s)
	if "$@" >"$out" 2>&1; then status=0; else status=$?; fi
	seconds=$(($(date +%s) - start))
	if [ "$status" -eq 0 ]; then
		printf '%-8s ok      %4ss\n' "$name" "$seconds"
		return
	fi
	printf '%-8s FAILED  %4ss  (exit %s)\n' "$name" "$seconds" "$status"
	explain "$name"
	exit "$status"
}

step fmt cargo fmt --check -- --color=never
if [ -z "$only" ]; then
	if command -v shellcheck >/dev/null && command -v actionlint >/dev/null; then
		step scripts scripts/lint
	else
		printf '%-8s skipped        (needs shellcheck and actionlint)\n' scripts
	fi
	step deny cargo deny check
	ultimate=$(ultimate/check --which)
	if [ ! -d "$ultimate/node_modules" ]; then
		printf '%-8s skipped        (no Ultimate with node_modules at %s)\n' ultimate "$ultimate"
	elif git diff --quiet main -- ultimate/ 2>/dev/null && [ -z "$(git ls-files --others --exclude-standard ultimate/)" ]; then
		printf '%-8s skipped        (ultimate/ unchanged from main)\n' ultimate
	else
		step ultimate env ULTIMATE="$ultimate" ultimate/check
	fi
fi
step clippy cargo clippy --all-targets -- -D warnings
linux=x86_64-unknown-linux-gnu
if rustc -vV | grep -qx "host: $linux"; then
	printf '%-8s skipped        (the host is %s: clippy covered it)\n' linux "$linux"
elif [ ! -d "$(rustc --print sysroot)/lib/rustlib/$linux" ]; then
	printf '%-8s skipped        (needs rustup target add %s)\n' linux "$linux"
else
	step linux cargo clippy --all-targets --target "$linux" -- -D warnings
fi
if [ -n "$only" ]; then
	step test env TMPDIR="$scratch" cargo test "$only"
else
	step test env TMPDIR="$scratch" cargo test
fi
