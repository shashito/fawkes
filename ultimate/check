#!/bin/sh
# Checks the Ultimate extension in ultimate/fawkes: runs its tests, then type-checks its server and web facets against
# an Ultimate checkout with node_modules. Ultimate's own checks never see this folder, so run it after changing the
# extension and before an upgrade. Exits non-zero on the first failure.
#
#   ultimate/check           run the checks
#   ultimate/check --which   print the Ultimate it would check against, and run nothing
#
# The Ultimate is $ULTIMATE when it is set, else "ultimateCheck" in .ultimate/settings.json (scripts/check and the
# lander read it from there too): a path ("~/" allowed), or "live" for the generation the Fawkes daemon this shell
# reaches runs (`fawkes status --json`, its <state_dir>/current), which falls back to ~/Code/ultimate with a note when
# that daemon or folder is not there. Without either, ~/Code/ultimate.
set -eu
here=$(cd "$(dirname "$0")" && pwd)

# The configured Ultimate, notes on stderr.
target() {
	if [ -n "${ULTIMATE:-}" ]; then
		echo "$ULTIMATE"
		return
	fi
	clone=$HOME/Code/ultimate
	setting=$(node -e '
		const fs = require("fs")
		try { process.stdout.write(JSON.parse(fs.readFileSync(process.argv[1], "utf8")).ultimateCheck ?? "") }
		catch (error) { if (error.code !== "ENOENT") throw error }' "$here/../.ultimate/settings.json")
	case $setting in
	"") echo "$clone" ;;
	live)
		state_dir=$("${FAWKES_BIN:-fawkes}" status --json 2>/dev/null | node -e '
			let text = ""
			process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
				try { process.stdout.write(JSON.parse(text).state_dir ?? "") } catch {}
			})') || true
		if [ -n "$state_dir" ] && [ -d "$state_dir/current/node_modules" ]; then
			echo "$state_dir/current"
		else
			echo "No live Fawkes generation with node_modules (fawkes status --json); checking $clone" >&2
			echo "$clone"
		fi
		;;
	\~/*) echo "$HOME/${setting#\~/}" ;;
	*) echo "$setting" ;;
	esac
}

ultimate=$(target)
case ${1:-} in
"") ;;
--which)
	echo "$ultimate"
	exit 0
	;;
*)
	echo "usage: ultimate/check [--which]" >&2
	exit 2
	;;
esac
[ -d "$ultimate/node_modules" ] || { echo "No Ultimate with node_modules at $ultimate; set ULTIMATE or ultimateCheck in .ultimate/settings.json" >&2; exit 1; }
echo "== against $ultimate"

echo "== tests"
ULTIMATE="$ultimate" node --test "$here"/fawkes/*.test.ts

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cat > "$work/server.json" <<EOF
{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ESNext", "DOM"],
    "types": ["node"], "typeRoots": ["$ultimate/node_modules/@types"],
    "paths": {
      "ultimate/*": ["$ultimate/*"],
      "@earendil-works/chord/context": ["$ultimate/node_modules/@earendil-works/chord/dist/context/index.d.ts"],
      "*": ["$ultimate/node_modules/@types/*", "$ultimate/node_modules/*"]
    },
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "noUnusedLocals": true
  },
  "include": ["$here/fawkes/*.ts"]
}
EOF
cat > "$work/web.json" <<EOF
{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["$ultimate/node_modules/vite-plus/dist/client.d.ts"], "jsx": "react-jsx",
    "paths": {
      "@/*": ["$ultimate/web/src/*"], "ultimate/*": ["$ultimate/*"],
      "*": ["$ultimate/node_modules/@types/*", "$ultimate/node_modules/*"]
    },
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "noUnusedLocals": true
  },
  "include": ["$here/fawkes/*.tsx"]
}
EOF
echo "== server types"
"$ultimate/node_modules/.bin/tsc" -p "$work/server.json"
echo "== web types"
"$ultimate/node_modules/.bin/tsc" -p "$work/web.json"
echo "The fawkes extension passes."
