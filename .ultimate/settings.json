{
  "isolates": {
    "worktree": {
      "setup": [
        "cargo fetch --locked",
        "[ -d target ] || [ ! -d \"$ULTIMATE_SOURCE/target\" ] || cp -cR \"$ULTIMATE_SOURCE/target\" target"
      ]
    }
  },
  "lander": {
    "checks": [
      { "command": "cargo fmt --check", "timeout": 60 },
      { "command": "cargo deny check", "timeout": 120 },
      { "command": "cargo clippy --all-targets -- -D warnings", "timeout": 300 },
      {
        "command": "d=$(mktemp -d /tmp/fkl.XXXXXX) && TMPDIR=\"$d\" cargo test; s=$?; rm -rf \"$d\"; exit $s",
        "timeout": 600
      }
    ]
  }
}
